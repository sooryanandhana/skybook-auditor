# Skybook AI Website Auditor — environment template.
#
# Copy to .env.local for development, or set these in your deploy platform's
# environment settings for production. NEVER commit real values: .env* is
# gitignored. All values below are placeholders.

# --- Required: authentication ---------------------------------------------
# The single operator login. SKYBOOK_PASSWORD_HASH is a hash of the password,
# not the password itself. SESSION_SECRET signs the session cookie — generate a
# fresh, long, random value for production.
SKYBOOK_EMAIL=
SKYBOOK_PASSWORD_HASH=
SESSION_SECRET=

# --- Required: AI explanations (Google Gemini) ----------------------------
GEMINI_API_KEY=

# --- Required: report email (Resend) --------------------------------------
# SKYBOOK_MAIL_FROM must be a sender address verified in your Resend account.
RESEND_API_KEY=
SKYBOOK_MAIL_FROM=

# --- Optional: Google PageSpeed performance check -------------------------
# Enables the optional PageSpeed/performance analysis. The audit runs without
# it; requests are unauthenticated (subject to Google's lower rate limit) when
# it is absent.
PAGESPEED_API_KEY=

# --- Optional: operational tuning -----------------------------------------
# Set SKYBOOK_TRUST_PROXY when running behind a reverse proxy / load balancer
# (Railway, Render, nginx) so rate limiting reads the real client IP from
# X-Forwarded-For instead of the proxy's address.
SKYBOOK_TRUST_PROXY=

# Per-IP audit rate limit (requests per minute). Has a built-in default.
AUDIT_RATE_LIMIT_PER_MINUTE=

# --- Optional: Puppeteer / Chromium (containerized deploys) ---------------
# Point Puppeteer at a system-installed Chromium and skip the bundled download.
# Leave unset to use Puppeteer's own downloaded browser.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_DOWNLOAD=
