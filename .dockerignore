# Keep the build context small and — above all — keep secrets and local state
# out of the image. .env* is excluded so no real credentials are ever baked in;
# the container reads its configuration from the platform's environment instead.
.git
.gitignore
node_modules
.next
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage
.env
.env.*
!.env.example
.vercel
*.tsbuildinfo
Dockerfile
.dockerignore
README.md
